# Which cluster and workload the evals borrow their environment from.
# The mirrord config reads these; nothing else needs changing.

# Empty means "whatever kubectl is pointed at right now".
EVAL_KUBE_CONTEXT=

EVAL_NAMESPACE=shop
EVAL_TARGET=chat-service

# Used by the eval process on your machine. The agent running inside the
# cluster reads its own key from the `shopping-agent` secret instead.
ANTHROPIC_API_KEY=
